PORT=5000

# ==========================================
# AI Service Configuration
# ==========================================
# Preferred Provider: 'gemini' (default) or 'openai'
AI_PROVIDER=gemini

# AI API Key (DO NOT commit your actual key)
# For Gemini: Get your free API key at https://aistudio.google.com/
# For OpenAI: Get your key at https://platform.openai.com/
AI_API_KEY=your_ai_api_key_here

# AI Model Name
# For Gemini: 'gemini-1.5-flash' (recommended, fast & free tier available)
# For OpenAI: 'gpt-4o-mini'
AI_MODEL=gemini-1.5-flash

# Custom API Base URL (Optional - only needed for custom proxies or local Ollama)
# AI_API_URL=https://api.openai.com/v1
